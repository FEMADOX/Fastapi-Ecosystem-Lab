{
  "name": "fastapi-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "nodemon --watch ../.env --exec \"next dev --turbopack\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "check:ci": "biome ci ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "http-proxy": "^1.18.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "next": "canary",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.19.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "babel-plugin-react-compiler": "0.0.0-experimental-592953e-20240517",
    "biome-standard": "github:robinwalterfit/biome-standard#v0.5.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.8",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mts,cts,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
