{
  "name": "fastapi-ecosystem",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:watch": "nodemon --watch ../.env --exec \"next dev --turbopack\"",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc": "tsgo --noEmit",
    "prepare": "effect-tsgo patch"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "event-source-polyfill": "^1.0.31",
    "http-proxy": "^1.18.1",
    "jose": "^6.2.2",
    "lucide-react": "^1.8.0",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@effect/tsgo": "0.5.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "babel-plugin-react-compiler": "1.0.0",
    "lint-staged": "^16.4.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.10",
    "shadcn": "^4.4.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mts,cts,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
