{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:3.14.3-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "learn_fastapi/src/main.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user uv; uv sync; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "api": "uv run learn_fastapi/src/main.py",
    "server": "uv run streamlit run learn_streamlit/src/app.py"
  },
  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8000,
    8501
  ]
}
